# Exemple de variables — NE JAMAIS COMMITER DE VRAIES VALEURS.
# Préproduction : copier vers /etc/techformanord/preprod.env (chmod 600, propriétaire root).
# Production    : copier vers /etc/techformanord/production.env (chmod 600).

# --- Préproduction ---------------------------------------------------------
# Nom d'hôte de préproduction (configurable). Exemple sans DNS : tfn-preprod.<ip-avec-tirets>.sslip.io
PREPROD_HOST=tfn-preprod.example.sslip.io
# Utilisateur:hash htpasswd (bcrypt ou apr1). Dans ce fichier, doubler chaque « $ » en « $$ ».
# Générer : htpasswd -nbB recette 'motdepasse' | sed -e 's/\$/\$\$/g'
PREPROD_BASIC_AUTH=recette:$$2y$$05$$remplacer-par-un-vrai-hash
PREPROD_LOCAL_PORT=8095
# URL canonique (production) utilisée dans les balises canonical, même en préproduction.
SITE_URL=https://techformanord.fr

# --- Production (formulaire) -------------------------------------------------
FORM_TO=contact@exemple.fr
FORM_FROM="Site Tech Formation Nord <no-reply@techformanord.fr>"
SMTP_HOST=smtp.ionos.fr
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@techformanord.fr
SMTP_PASS=a-renseigner

# --- Production (mesure, facultatif) ----------------------------------------
# '' (aucune) ou 'plausible' (sans cookie). GA4 non intégré : il exigerait une plateforme de consentement.
PUBLIC_ANALYTICS_PROVIDER=
PUBLIC_ANALYTICS_ID=
# Jeton de vérification Search Console (méta) si la propriété n'est pas vérifiée par DNS.
PUBLIC_GSC_VERIFICATION=

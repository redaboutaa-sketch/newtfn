---
// Catalogue : une carte par formation (visuel, nom, durée si publiée). Les programmes détaillés
// restent sur les fiches (automobile) ou sur les sites des pôles (beauté, IA).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import FormationCard from '../../components/FormationCard.astro';
import { poles } from '../../lib/data';
import { autoCards, beauteCards, iaCards } from '../../lib/cards';

const fiches = (await getCollection('fiches')).map((f) => f.data).sort((a, b) => a.ordre - b.ordre);
const ps = poles();
const lien: Record<string, string> = { automobile: 'Présentation du pôle', beaute: 'Le pôle beauté', ia: 'Le pôle IA' };
---
<Base title="Catalogue des formations : automobile, beauté et IA" description="Toutes les formations de Tech Formation Nord à Vendeville, près de Lille : maintenance, carrosserie, commerce automobile, reconversion, esthétique et intelligence artificielle." breadcrumbs={[{ name: 'Nos formations', url: '/services/' }]} navActive="formations">
  <section class="page-hero">
    <div class="container hero-enter">
      <span class="eyebrow">Catalogue</span>
      <h1>Nos formations</h1>
      <p class="lead">Trois domaines, des modules courts de perfectionnement et des parcours longs de reconversion.</p>
      <nav aria-label="Accès rapide aux domaines" class="btn-row">
        {ps.map((p) => <a class="btn btn--ghost" href={`#${p.id}`}>{p.nom}</a>)}
      </nav>
    </div>
  </section>

  {ps.map((p, i) => (
    <section class={`section ${i % 2 ? 'section--surface' : ''}`} id={p.id} aria-labelledby={`h-${p.id}`} data-accent={p.accent}>
      <div class="container">
        <div class="cat-head">
          <h2 id={`h-${p.id}`}>{p.nom}</h2>
          <a class="link-arrow" href={p.url}>{lien[p.id]}</a>
        </div>

        {p.id === 'automobile' && (
          <>
            <h3 class="cat-sub">Modules de perfectionnement</h3>
            <ul class="fcards" data-reveal="fade">{autoCards(fiches, 'catalogue').map((c) => <FormationCard {...c} level={3} />)}</ul>
            <h3 class="cat-sub">Parcours de reconversion</h3>
            <ul class="fcards" data-reveal="fade">{autoCards(fiches, 'parcours').map((c) => <FormationCard {...c} level={3} />)}</ul>
          </>
        )}

        {p.id === 'beaute' && (
          <>
            {beauteCards().map(({ famille, cards }: any) => (
              <>
                <h3 class="cat-sub">{famille.nom}</h3>
                <ul class="fcards" data-reveal="fade">{cards.map((c: any) => <FormationCard {...c} level={4} />)}</ul>
              </>
            ))}
            <p class="small muted cat-note">Programmes, tarifs et sessions des formations esthétiques sur maisonbeauxlieux.com.</p>
          </>
        )}

        {p.id === 'ia' && (
          <>
            <ul class="fcards" data-reveal="fade" style="margin-top:24px">{iaCards().map((c) => <FormationCard {...c} level={3} />)}</ul>
            <p class="small muted cat-note">Programmes détaillés, tarifs et sessions des formations IA sur iatechformanord.fr.</p>
          </>
        )}
      </div>
    </section>
  ))}
  <CtaBand />
</Base>

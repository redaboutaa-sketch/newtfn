---
import Base from '../layouts/Base.astro';
---
<Base title="Page introuvable" description="La page demandée n’existe pas ou a été déplacée. Retrouvez les formations de Tech Formation Nord depuis l’accueil ou le catalogue." noindex>
  <section class="section">
    <div class="container narrow">
      <span class="eyebrow">Erreur 404</span>
      <h1>Page introuvable</h1>
      <p class="lead">La page demandée n’existe pas ou n’est plus disponible.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/services/">Voir nos formations</a>
        <a class="btn btn--ghost" href="/">Retour à l’accueil</a>
        <a class="btn btn--ghost" href="/contact-us/">Nous contacter</a>
      </div>
    </div>
  </section>
</Base>

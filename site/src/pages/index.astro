---
import Base from '../layouts/Base.astro';
import { poles } from '../lib/data';
import Picture from '../components/Picture.astro';
import '../styles/espaces.css';
const univers = poles();
const automobile = univers.find((pole) => pole.id === 'automobile')!;
const beaute = univers.find((pole) => pole.id === 'beaute')!;
---
<Base chrome="portail" title="Tech Formation Nord — Formations près de Lille et espace pédagogique" description="Accédez aux formations automobiles de Tech Formation Nord à Vendeville près de Lille, à TrainingForMe et aux formations esthétique et bien-être de Maison Beauxlieux.">
  <header slot="entete" class="espaces-header container">
    <a href="/"><img src="/img/logo-tfn.png" alt="Tech Formation Nord" width="200" height="68" /></a>
    <nav aria-label="Navigation principale"><a href="/tech-formation-nord/">Tous nos univers</a><a href="/contact-us/">Contact</a></nav>
  </header>
  <section class="espaces container" aria-labelledby="espaces-titre">
    <h1 id="espaces-titre">Choisissez votre espace</h1>
    <div class="espaces-grid">
      <a class="espace" href={automobile.portail.destination} data-track="univers" data-pole={automobile.id}>
        <span class="espace-image"><Picture id="portail-automobile" sizes="(max-width: 680px) 90vw, 400px" priority decorative /></span>
        <span class="espace-corps"><strong>{automobile.portail.titre}</strong><span>{automobile.portail.marque}</span><span class="espace-action">Découvrir les formations</span></span>
      </a>
      <a class="espace espace-lms" href="/trainingforme/">
        <span class="espace-image"><Picture id="portail-ia" sizes="(max-width: 680px) 90vw, 400px" priority decorative /></span>
        <span class="espace-corps"><strong>TrainingForMe</strong><span>Espace pédagogique, accès apprenant, formateur et administration</span><span class="espace-action">Accéder à la plateforme</span></span>
      </a>
      <a class="espace" href={beaute.portail.destination} data-track="univers" data-pole={beaute.id}>
        <span class="espace-image"><Picture id="portail-esthetique" sizes="(max-width: 680px) 90vw, 400px" priority decorative /></span>
        <span class="espace-corps"><strong>{beaute.portail.titre}</strong><span>{beaute.portail.marque}</span><span class="espace-action">Découvrir les formations</span></span>
      </a>
    </div>
  </section>
  <footer slot="pied" class="espaces-footer container"><a href="/mentions-legales/">Mentions légales</a><a href="/politique-de-confidentialite/">Confidentialité</a><a href="/accessibilite-handicap/">Accessibilité</a></footer>
</Base>

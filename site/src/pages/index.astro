---
import Base from '../layouts/Base.astro';
import { poles } from '../lib/data';
import Picture from '../components/Picture.astro';
import '../styles/espaces.css';
// Accueil : trois univers (Automobile, Intelligence artificielle, Esthétique et bien-être),
// puis une carte transversale « Formations en ligne » (TrainingForMe) commune aux univers.
const univers = poles();
const automobile = univers.find((pole) => pole.id === 'automobile')!;
const ia = univers.find((pole) => pole.id === 'ia')!;
const beaute = univers.find((pole) => pole.id === 'beaute')!;
---
<Base chrome="portail" title="Tech Formation Nord — Formations près de Lille et espace pédagogique" description="Accédez aux formations automobiles de Tech Formation Nord à Vendeville près de Lille, aux formations en intelligence artificielle, aux formations esthétique et bien-être de Maison Beauxlieux et aux formations en ligne TrainingForMe.">
  <header slot="entete" class="espaces-header container">
    <a href="/"><img src="/img/logo-tfn.png" alt="Tech Formation Nord" width="200" height="68" /></a>
    <nav aria-label="Navigation principale"><a href="/contact-us/">Contact</a></nav>
  </header>
  <section class="espaces container" aria-labelledby="espaces-titre">
    <h1 id="espaces-titre">Choisissez votre formation</h1>
    <div class="espaces-grid">
      <a class="espace" href={automobile.portail.destination} data-track="univers" data-pole={automobile.id}>
        <span class="espace-image"><Picture id="portail-automobile" sizes="(max-width: 820px) 120px, 400px" priority decorative /></span>
        <span class="espace-corps"><strong>{automobile.portail.titre}</strong><span class="espace-action">Voir les formations auto</span></span>
      </a>
      <a class="espace" href={ia.portail.destination} data-track="univers" data-pole={ia.id}>
        <span class="espace-image"><Picture id="portail-ia" sizes="(max-width: 820px) 120px, 400px" priority decorative /></span>
        <span class="espace-corps"><strong>{ia.portail.titre}</strong><span class="espace-action">Voir les formations IA</span></span>
      </a>
      <a class="espace" href={beaute.portail.destination} data-track="univers" data-pole={beaute.id}>
        <span class="espace-image"><Picture id="portail-esthetique" sizes="(max-width: 820px) 120px, 400px" priority decorative /></span>
        <span class="espace-corps"><strong>{beaute.portail.titre}</strong><span class="espace-action">Voir les formations beauté</span></span>
      </a>
      <a class="espace espace-transversal" href="https://trainingforme.fr/" data-track="univers" data-pole="formations-en-ligne">
        <span class="espace-image"><Picture id="portail-en-ligne" sizes="(max-width: 820px) 100vw, 560px" decorative /></span>
        <span class="espace-corps"><strong>Formations en ligne</strong><span>Retrouvez nos formations en ligne, accessibles à votre rythme.</span><span class="espace-action">Découvrir les formations en ligne</span></span>
      </a>
    </div>
  </section>
  <footer slot="pied" class="espaces-footer container"><a href="/mentions-legales/">Mentions légales</a><a href="/politique-de-confidentialite/">Confidentialité</a><a href="/accessibilite-handicap/">Accessibilité</a></footer>
</Base>

---
// Portail : page d'entrée courte présentant les trois univers de Tech Formation Nord.
// Chaque univers est un seul lien HTML (logo, illustration, intitulé, appel à l'action), même onglet.
import Base from '../layouts/Base.astro';
import Sketch from '../components/Sketch.astro';
import WhatsAppLink from '../components/WhatsAppLink.astro';
import { organisme, poles } from '../lib/data';

const org = organisme();
const sketch: Record<string, 'automobile' | 'beaute' | 'ia'> = { automobile: 'automobile', beaute: 'beaute', ia: 'ia' };
const univers = poles();
---
<Base chrome="portail" title="Tech Formation Nord — Formations automobile, esthétique et intelligence artificielle près de Lille" description="Tech Formation Nord, organisme de formation certifié Qualiopi à Vendeville, près de Lille : trois univers de formation, l’automobile, l’esthétique et le bien-être avec Maison Beauxlieux, et l’intelligence artificielle.">
    <header class="portail-top container" slot="entete">
      <a class="portail-brand" href="/"><img src="/img/logo-tfn.png" alt="Tech Formation Nord" width="401" height="136" /></a>
      <a class="portail-call" href={`tel:${org.telephone.lien}`} data-place="portail-entete"><span class="sr-only">Appeler le </span>{org.telephone.affiche}</a>
    </header>

    <section class="portail-intro container" aria-labelledby="portail-titre">
      <h1 id="portail-titre">Tech Formation Nord</h1>
      <p>Trois univers pour développer vos compétences.</p>
    </section>

    <ul class="universes container" aria-label="Nos trois univers de formation">
      {univers.map((u: any, i: number) => (
        <li class="universe" data-accent={u.accent} style={`--i:${i}`}>
          <a class="universe-link" href={u.portail.destination} data-track="univers" data-pole={u.id}>
            <span class="u-logo"><img src={u.portail.logo.src} alt={u.portail.marque} width={u.portail.logo.width} height={u.portail.logo.height} style={`--h:${u.portail.logo.hauteur}px`} /></span>
            <span class="u-sketch"><Sketch name={sketch[u.id]} /></span>
            <span class="u-text">
              <h2 class="u-name">{u.portail.titre}</h2>
              <span class="u-cta">Découvrir les formations <span class="u-arrow" aria-hidden="true">→</span></span>
              {u.portail.domaine && <span class="u-domain">{u.portail.domaine}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>

    <footer class="portail-foot" slot="pied">
      <div class="container">
        <ul class="portail-contact" aria-label="Nous contacter">
          <li><a class="pc-item" href={`tel:${org.telephone.lien}`} data-place="portail"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M6.6 3.5h3l1.4 4-2 1.3a11 11 0 0 0 6.2 6.2l1.3-2 4 1.4v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"/></svg>{org.telephone.affiche}</a></li>
          <li><WhatsAppLink place="portail" class="pc-item pc-whatsapp" label="WhatsApp" /></li>
          <li><a class="pc-item" href={`mailto:${org.email}`} data-place="portail"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M3.5 6h17v12h-17zM3.5 6.5 12 13l8.5-6.5"/></svg>{org.email}</a></li>
          <li><span class="pc-item"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>{org.adresse.rue}, {org.adresse.code_postal} {org.adresse.ville} · près de Lille</span></li>
        </ul>
        <div class="portail-legal">
          {org.qualiopi.afficher && <a class="portail-qualiopi" href="/qualite/"><img src={org.qualiopi.logo} alt="Qualiopi — processus certifié — République française" width="430" height="183" loading="lazy" /><span>Organisme certifié Qualiopi au titre des actions de formation</span></a>}
          <p>
            <span>© {new Date().getFullYear()} {org.nom} — NDA {org.nda}</span>
            <span><a href="/qualite/">Qualité</a> · <a href="/mentions-legales/">Mentions légales</a> · <a href="/politique-de-confidentialite/">Confidentialité</a> · <a href="/accessibilite-handicap/">Accessibilité</a> · <a href="/contact-us/">Contact</a></span>
          </p>
        </div>
      </div>
    </footer>
</Base>

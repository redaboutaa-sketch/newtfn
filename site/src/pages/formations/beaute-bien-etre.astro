---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import FormationCard from '../../components/FormationCard.astro';
import { beauteCards } from '../../lib/cards';
import Bridge from '../../components/Bridge.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { pole } from '../../lib/data';

const p = pole('beaute');
const ext = p.site_externe;
const toutes = p.familles.flatMap((f: any) => f.formations);
const faq = [
  { q: 'Où se déroulent les formations esthétiques ?', a: `<p>À Vendeville, au sud de Lille, dans les espaces professionnels de Maison Beauxlieux (${ext.adresse}). Le lieu exact et les dates de chaque session sont confirmés lors de l’inscription.</p>` },
  { q: 'Faut-il être déjà diplômé en esthétique ?', a: '<p>Cela dépend de la formation. Certaines s’adressent aux professionnels de l’esthétique déjà en exercice, d’autres sont ouvertes aux débutants (extensions de cils, pose gel et capsules). Le public visé est indiqué sur chaque programme ; l’équipe confirme les prérequis avant toute inscription.</p>' },
  { q: 'Combien coûte une formation et peut-elle être financée ?', a: `<p>Les tarifs en financement personnel sont publiés sur chaque programme de <a href="${ext.formations_url}">maisonbeauxlieux.com</a>. Un financement n’est jamais automatique : l’éligibilité d’une formation à un dispositif (OPCO, FAFCEA, aide de France Travail…) doit être confirmée pour la formation choisie et votre situation, avant l’inscription.</p>` },
  { q: 'Quelle différence entre les formations et la location d’espaces ?', a: `<p>Les formations sont des actions de formation professionnelle, avec un programme et un formateur. Maison Beauxlieux propose par ailleurs, de façon distincte, la location de cabines et d’espaces équipés aux professionnels de la beauté qui souhaitent y recevoir leur clientèle : cette offre de location n’est pas une formation. <a href="${ext.espaces_url}">Voir les espaces à louer</a>.</p>` },
  { q: 'Qui délivre ces formations ?', a: `<p>${ext.relation} <a href="/qualite/">Voir la certification de Tech Formation Nord</a>.</p>` },
];
---
<Base title="Formations esthétique, beauté et bien-être près de Lille" description="Formations courtes en esthétique à Vendeville avec Maison Beauxlieux : regard, soins du visage, corps et bien-être, cheveux, ongles. Publics, durées et accès aux programmes." breadcrumbs={[{ name: 'Nos formations', url: '/services/' }, { name: p.nom, url: p.url }]} pole="beaute" navActive="formations">
  <section class="page-hero" data-accent="beaute">
    <div class="container hero-grid">
      <div class="hero-enter">
        <span class="eyebrow">Pôle esthétique, beauté et bien-être</span>
        <h1>Formations esthétique, beauté et bien-être</h1>
        <p class="lead">Des formations courtes, de 7 à 35 heures, pour maîtriser de nouvelles techniques et enrichir votre carte de prestations. Elles se déroulent à Vendeville, près de Lille, dans les espaces de Maison Beauxlieux.</p>
        <div class="btn-row">
          <a class="btn btn--primary" style="background:var(--beaute)" href={ext.formations_url} data-track="passerelle" data-pole="beaute">Découvrir les formations beauté chez Maison Beauxlieux <span aria-hidden="true">↗</span></a>
          <a class="btn btn--ghost" href="#familles">Parcourir les thématiques</a>
        </div>
      </div>
      <div class="hero-media hero-enter"><Picture id="beaute-ongles" priority sizes="(max-width: 900px) 92vw, 44vw" /></div>
    </div>
  </section>

  <section class="section">
    <div class="container editorial-cols" data-accent="beaute" data-reveal>
      <div>
        <h2 style="font-size:1.3rem">Pour qui ?</h2>
        <ul>{p.publics.map((x: string) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <h2 style="font-size:1.3rem">Objectifs</h2>
        <ul>
          <li>Acquérir une technique précise, de la théorie à la pratique encadrée</li>
          <li>Proposer de nouvelles prestations à sa clientèle</li>
          <li>Travailler dans le respect des règles d’hygiène et du cadre réglementaire de chaque technique</li>
        </ul>
      </div>
      <div>
        <h2 style="font-size:1.3rem">Modalités</h2>
        <ul>
          <li>Formations en présentiel, de 7 à 35 heures selon la technique</li>
          <li>Théorie et pratique encadrée, sur support d’entraînement puis sur modèle lorsque le programme le prévoit</li>
          <li>Tarifs publiés pour un financement personnel ; devis sur demande pour un projet de financement</li>
          <li>Prérequis confirmés avec l’équipe avant l’inscription</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--surface" id="familles" aria-labelledby="familles-titre" data-accent="beaute">
    <div class="container">
      <h2 id="familles-titre">Les grandes familles de formations</h2>
      <p class="lead">{toutes.length} formations sont actuellement proposées. Chaque carte ouvre le programme détaillé sur maisonbeauxlieux.com.</p>
      {beauteCards().map(({ famille, cards }: any) => (
        <>
          <h3 class="cat-sub">{famille.nom}</h3>
          <ul class="fcards" data-reveal="fade">{cards.map((c: any) => <FormationCard {...c} level={4} />)}</ul>
        </>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2" data-reveal>
      <Bridge pole={p} url={ext.formations_url} label="Consulter les programmes, tarifs et sessions" titre="Programmes détaillés et inscriptions sur Maison Beauxlieux" />
      <aside class="card">
        <h2 style="font-size:1.3rem">Location d’espaces : une offre distincte</h2>
        <p>Indépendamment des formations, Maison Beauxlieux loue des cabines et espaces équipés aux esthéticiennes, prothésistes ongulaires et praticiens du bien-être qui souhaitent y recevoir leur clientèle. Cette activité de location ne constitue pas une formation.</p>
        <p class="small muted">{ext.marque} — {ext.adresse} — {ext.telephone} — {ext.horaires}</p>
        <a class="link-arrow" href={ext.espaces_url} data-track="passerelle" data-pole="beaute">Voir les espaces à louer chez Maison Beauxlieux</a>
      </aside>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container narrow" data-reveal><Faq items={faq} /></div>
  </section>
  <CtaBand titre="Une question sur une formation beauté ?" texte="Contactez Tech Formation Nord ou directement l’équipe de Maison Beauxlieux pour vérifier les prérequis, les prochaines sessions et les possibilités de financement." sujet="Formation esthétique" />
</Base>

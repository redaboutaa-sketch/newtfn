---
import Base from '../../layouts/Base.astro';
import Picture from '../../components/Picture.astro';
import IaArt from '../../components/IaArt.astro';
import Bridge from '../../components/Bridge.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import { pole } from '../../lib/data';

const p = pole('ia');
const ext = p.site_externe;
const usages = [
  { t: 'Rédiger et répondre', d: 'Réponses aux demandes clients, devis types, relances, publications pour les réseaux sociaux, réponses aux avis.' },
  { t: 'Synthétiser et analyser', d: 'Comptes rendus, rapports, reformulations, préparation de présentations à partir de vos documents.' },
  { t: 'Être visible en ligne', d: 'Clarifier son offre, structurer un site simple, préparer sa fiche d’établissement et ses contenus locaux.' },
  { t: 'Gagner du temps', d: 'Identifier les tâches répétitives et concevoir un premier assistant IA, avec des règles d’usage et une validation humaine.' },
  { t: 'Utiliser l’IA prudemment', d: 'Ce qu’il ne faut pas confier à un outil d’IA, protection des données personnelles et vérification des réponses.' },
];
const faq = [
  { q: 'Faut-il savoir programmer pour suivre une formation IA ?', a: '<p>Non. Les formations portent sur des usages professionnels courants : décrire son besoin, donner le bon contexte à l’outil et vérifier les résultats. Savoir utiliser un ordinateur et naviguer sur internet suffit pour les parcours d’initiation.</p>' },
  { q: 'Quels outils sont abordés ?', a: '<p>Les ateliers s’appuient principalement sur ChatGPT et, selon les parcours, sur d’autres assistants (Claude, Gemini, Copilot) et des outils d’automatisation comme Make ou Zapier. Un abonnement payant n’est pas indispensable pour suivre la formation.</p>' },
  { q: 'Les formations ont-elles lieu à Lille ou à distance ?', a: '<p>La formation pour artisans et TPE se déroule principalement en présentiel à Lille. Les formations pour les entreprises peuvent être organisées dans vos locaux, à Lille ou à distance. Le lieu exact et le calendrier sont confirmés avant l’inscription.</p>' },
  { q: 'Comment financer une formation en intelligence artificielle ?', a: '<p>Selon votre statut : plan de développement des compétences de l’entreprise, OPCO de votre branche, fonds d’assurance formation des indépendants, financement personnel… Aucune prise en charge n’est automatique : l’éligibilité et un éventuel reste à charge sont à vérifier avant tout engagement. <a href="/financer-sa-formation/">Les solutions de financement</a>.</p>' },
  { q: 'Les données de mon entreprise sont-elles en sécurité avec l’IA ?', a: '<p>Les formations intègrent un temps consacré à l’usage responsable de l’IA : ne pas transmettre de données confidentielles ou personnelles sans précaution, vérifier les réponses et garder la décision humaine. La CNIL publie des recommandations utiles sur <a href="https://www.cnil.fr/fr/intelligence-artificielle" rel="noopener">l’intelligence artificielle et la protection des données</a>.</p>' },
];
---
<Base title="Formations intelligence artificielle à Lille : entreprises, TPE, particuliers" description="Formations à l’IA générative près de Lille : usages concrets pour artisans et TPE, équipes en entreprise et particuliers. Publics, objectifs, formats et accès aux programmes." breadcrumbs={[{ name: 'Nos formations', url: '/services/' }, { name: p.nom, url: p.url }]} pole="ia" navActive="formations">
  <section class="page-hero" data-accent="ia">
    <div class="container hero-grid">
      <div class="hero-enter">
        <span class="eyebrow">Pôle intelligence artificielle et numérique</span>
        <h1>Formations à l’intelligence artificielle</h1>
        <p class="lead">Apprendre à utiliser l’IA générative dans son travail, à partir de ses propres tâches : rédaction, relation client, présence en ligne et organisation. Des formats pour les artisans et TPE, les équipes en entreprise et les particuliers.</p>
        <div class="btn-row">
          <a class="btn btn--primary" style="background:var(--ia)" href={ext.url} data-track="passerelle" data-pole="ia">Consulter les programmes IA de Tech Formation Nord <span aria-hidden="true">↗</span></a>
          <a class="btn btn--ghost" href="#publics">Choisir selon votre profil</a>
        </div>
      </div>
      <div class="hero-media hero-media--art hero-enter"><IaArt /></div>
    </div>
  </section>

  <section class="section" aria-labelledby="usages-titre">
    <div class="container">
      <h2 id="usages-titre">Des usages professionnels concrets</h2>
      <p class="lead">Les ateliers partent de cas réels de votre activité et produisent des ressources réutilisables dès le retour au travail.</p>
      <div class="grid grid-3" data-reveal style="margin-top:24px" data-accent="ia">
        {usages.map((u) => <article class="card card--flat"><h3 style="font-size:1.1rem">{u.t}</h3><p class="small">{u.d}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section section--surface" id="publics" aria-labelledby="publics-titre">
    <div class="container">
      <h2 id="publics-titre">Une formation selon votre profil</h2>
      <div class="grid grid-3" data-reveal style="margin-top:24px" data-accent="ia">
        {p.familles.map((fam: any) => (
          <article class="card">
            <span class="tag">{fam.nom}</span>
            <p>{fam.description}</p>
            <ul class="small">{fam.points.map((x: string) => <li>{x}</li>)}</ul>
            <div class="card-foot"><a class="link-arrow" href={fam.lien.url} data-track="passerelle" data-pole="ia">{fam.lien.libelle}</a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid-2" data-reveal>
      <div>
        <h2 style="font-size:1.4rem">Comment se déroule l’accompagnement ?</h2>
        <ol>
          <li><strong>Diagnostic de départ</strong> : questionnaire de positionnement et échange pour identifier votre niveau et vos tâches prioritaires.</li>
          <li><strong>Sessions de formation</strong> : ateliers construits autour de vos cas d’usage, en petits groupes.</li>
          <li><strong>Livrables</strong> : bibliothèque de requêtes (prompts), cas d’usage priorisés, premier assistant IA selon le parcours.</li>
          <li><strong>Plan d’action</strong> : feuille de route pour poursuivre en autonomie après la formation.</li>
        </ol>
      </div>
      <Bridge pole={p} url={ext.url} label="Consulter les programmes IA de Tech Formation Nord" titre="Programmes détaillés, tarifs et prochaines sessions" />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container narrow" data-reveal><Faq items={faq} /></div>
  </section>
  <CtaBand titre="Former vos équipes à l’IA ?" texte="Présentez-nous votre activité et vos objectifs : nous vous orientons vers le format adapté et préparons un devis." sujet="Formation intelligence artificielle" />
</Base>

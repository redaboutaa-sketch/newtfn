---
// Composition graphique du pôle IA : fenêtres d'usages concrets (réponse client, devis, synthèse).
// Illustration abstraite, sans capture d'un produit réel ni scène de formation.
interface Props { class?: string; compact?: boolean }
const { class: cls, compact = false } = Astro.props;
---
<svg class={cls} viewBox={compact ? "24 70 380 300" : "0 0 640 480"} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="ia-dots" width="24" height="24" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.3" fill="#fff" opacity=".13" /></pattern>
    <linearGradient id="ia-glow" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#b7a8f5" stop-opacity=".55" /><stop offset="1" stop-color="#b7a8f5" stop-opacity="0" /></linearGradient>
  </defs>
  <rect width="640" height="480" fill="url(#ia-dots)" />
  <circle cx="520" cy="70" r="150" fill="url(#ia-glow)" opacity=".5" />
  <path d="M168 196 C 240 196, 250 262, 330 262 M420 150 C 470 150, 470 230, 520 236" stroke="#b7a8f5" stroke-opacity=".5" stroke-width="1.5" fill="none" stroke-dasharray="4 6" />
  <g transform="translate(64 92)">
    <rect width="230" height="150" rx="16" fill="#fff" fill-opacity=".08" stroke="#fff" stroke-opacity=".22" />
    <circle cx="22" cy="24" r="5" fill="#b7a8f5" /><text x="36" y="29" fill="#e9e4ff" font-family="Inter, Arial, sans-serif" font-size="13" font-weight="600">Réponse client</text>
    <rect x="18" y="50" width="190" height="8" rx="4" fill="#fff" fill-opacity=".55" />
    <rect x="18" y="68" width="160" height="8" rx="4" fill="#fff" fill-opacity=".35" />
    <rect x="18" y="86" width="176" height="8" rx="4" fill="#fff" fill-opacity=".35" />
    <rect x="18" y="112" width="92" height="22" rx="11" fill="#b7a8f5" /><text x="34" y="127" fill="#1b1450" font-family="Inter, Arial, sans-serif" font-size="11" font-weight="700">Vérifier</text>
  </g>
  <g transform="translate(330 196)">
    <rect width="250" height="170" rx="16" fill="#fff" fill-opacity=".1" stroke="#fff" stroke-opacity=".25" />
    <circle cx="22" cy="24" r="5" fill="#7db9ea" /><text x="36" y="29" fill="#e9e4ff" font-family="Inter, Arial, sans-serif" font-size="13" font-weight="600">Devis</text>
    <g fill="#fff">
      <rect x="18" y="52" width="120" height="7" rx="3.5" fill-opacity=".45" /><rect x="190" y="52" width="40" height="7" rx="3.5" fill-opacity=".45" />
      <rect x="18" y="74" width="100" height="7" rx="3.5" fill-opacity=".3" /><rect x="190" y="74" width="40" height="7" rx="3.5" fill-opacity=".3" />
      <rect x="18" y="96" width="140" height="7" rx="3.5" fill-opacity=".3" /><rect x="190" y="96" width="40" height="7" rx="3.5" fill-opacity=".3" />
    </g>
    <line x1="18" y1="120" x2="232" y2="120" stroke="#fff" stroke-opacity=".25" />
    <rect x="150" y="134" width="80" height="10" rx="5" fill="#b7a8f5" />
  </g>
  {!compact && (
    <g transform="translate(400 56)">
      <rect width="170" height="104" rx="14" fill="#fff" fill-opacity=".07" stroke="#fff" stroke-opacity=".2" />
      <circle cx="20" cy="22" r="5" fill="#f0a3c3" /><text x="34" y="27" fill="#e9e4ff" font-family="Inter, Arial, sans-serif" font-size="13" font-weight="600">Synthèse</text>
      <rect x="18" y="46" width="134" height="7" rx="3.5" fill="#fff" fill-opacity=".4" />
      <rect x="18" y="62" width="110" height="7" rx="3.5" fill="#fff" fill-opacity=".28" />
      <rect x="18" y="78" width="122" height="7" rx="3.5" fill="#fff" fill-opacity=".28" />
    </g>
  )}
  {!compact && <g transform="translate(64 300)">
    <rect width="236" height="48" rx="24" fill="#fff" fill-opacity=".95" />
    <rect x="22" y="20" width="120" height="8" rx="4" fill="#5b3fc4" fill-opacity=".35" />
    <circle cx="212" cy="24" r="14" fill="#5b3fc4" /><path d="M206 24h12M213 19l5 5-5 5" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" />
  </g>}
</svg>

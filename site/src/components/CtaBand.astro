---
import { organisme } from '../lib/data';
interface Props { titre?: string; texte?: string; sujet?: string }
const org = organisme();
const { titre = 'Besoin d’aide pour choisir votre formation ?', texte = 'Décrivez votre projet : nous vous orientons vers le parcours adapté et étudions avec vous les possibilités de financement.', sujet } = Astro.props;
const href = sujet ? `/contact-us/?sujet=${encodeURIComponent(sujet)}#formulaire` : '/contact-us/#formulaire';
---
<section class="section section--tight" style="background:var(--night);color:#e6edf5">
  <div class="container" style="display:flex;flex-wrap:wrap;gap:24px;align-items:center;justify-content:space-between">
    <div style="max-width:62ch">
      <h2 style="color:#fff">{titre}</h2>
      <p style="margin:0">{texte}</p>
    </div>
    <div class="btn-row" style="margin:0">
      <a class="btn btn--light" href={href}>Demander un conseil</a>
      <a class="btn btn--ghost" style="color:#fff" href={`tel:${org.telephone.lien}`} data-place="bandeau-cta">Appeler le {org.telephone.affiche}</a>
    </div>
  </div>
</section>

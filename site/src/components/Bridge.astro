---
// Passerelle explicite vers un site spécialisé : destination et lien entre marques affichés.
interface Props { pole: any; url: string; label: string; titre?: string }
const { pole, url, label, titre } = Astro.props;
const ext = pole.site_externe;
const host = new URL(url).hostname;
---
<aside class="bridge" data-accent={pole.accent} aria-labelledby={`bridge-${pole.id}`}>
  <h2 id={`bridge-${pole.id}`}>{titre ?? `Les programmes détaillés sur ${ext.marque}`}</h2>
  <p>{ext.relation}</p>
  <p class="muted small">Le lien ci-dessous ouvre le site {host}, dans le même onglet.</p>
  <div class="btn-row">
    <a class="btn btn--primary" href={url} data-track="passerelle" data-pole={pole.id}>{label} <span aria-hidden="true">↗</span></a>
  </div>
</aside>
